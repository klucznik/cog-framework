{
	"name": "klucznik/cog-framework",
	"description": "PHP framework built on Symfony components",
	"type": "library",
	"license": "MIT",
	"keywords": ["framework", "symfony", "codegen", "orm"],
	"homepage": "https://github.com/klucznik/cog-framework",
	"authors": [
		{
			"name": "Zbyszek Czarnecki",
			"email": "klucznik@produktiva.net"
		}
	],
	"support": {
		"issues": "https://github.com/klucznik/cog-framework/issues",
		"source": "https://github.com/klucznik/cog-framework"
	},
	"require": {
		"php": ">=8.5",
		"ext-mbstring": "*",
		"ext-json": "*",
		"ext-dom": "*",
		"ext-libxml": "*",
		"ext-mysqli": "*",
		"ext-simplexml": "*",
		"symfony/cache": "^7.4||^8.0",
		"symfony/translation": "^7.4||^8.0",
		"symfony/filesystem": "^7.4||^8.0",
		"symfony/routing": "^7.4||^8.0",
		"symfony/http-kernel": "^7.4||^8.0",
		"symfony/http-foundation": "^7.4||^8.0",
		"symfony/yaml": "^7.4||^8.0",
		"symfony/config": "^7.4||^8.0",
		"symfony/console": "^7.4||^8.0",
		"symfony/stopwatch": "^7.4||^8.0",
		"symfony/mime": "^7.4||^8.0",
		"symfony/string": "^7.4||^8.0",
		"symfony/dependency-injection": "^7.4||^8.0",
		"symfony/event-dispatcher": "^7.4||^8.0",
		"symfony/error-handler": "^7.4||^8.0",
		"nesbot/carbon": "^3.0",
		"psr/simple-cache": "^3.0",
		"psy/psysh": "^v0.12.24",
		"robmorgan/phinx": "^0.16.12"
	},
	"require-dev": {
		"phpunit/phpunit": "^13.2.6",
		"vlucas/phpdotenv": "^5.6"
	},
	"autoload": {
		"psr-4": {
			"Cog\\": "src"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"Cog\\ExampleApp\\": "app",
			"Generated\\": "generated"
		}
	},
	"scripts": {
		"test": "phpunit"
	},
	"config": {
		"sort-packages": true
	}
}
