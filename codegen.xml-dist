<?xml version="1.0" encoding="UTF-8" ?>
<codegen>
<!--
	This XML file defines the settings used when running the Code Generator.
	When running Cog\Codegen\CodeGen, you must specify a CodeGenSettings XML file like
	this one to use.  Feel free to copy, modify, etc.
-->
	<!-- General Cog\Codegen\CodeGen Settings -->
	<name application="My Application"/>
	<templateEscape begin="&lt;%" end="%&gt;"/>

	<!-- Define Data Sources (e.g. Databases, Services, etc.) -->
	<dataSources>

		<database index="1">
			<!-- The tag may be repeated to layer template directories, for example the
			     framework's own set plus your application's additions:
			         <templates path="/vendor/klucznik/cog-framework/codegen"/>
			         <templates path="/templates/codegen"/>
			     Paths are resolved against the docroot and applied in document order, so
			     a later entry overrides an earlier one. The unit of override is the module
			     directory (e.g. db_orm/class_gen) as a whole, never an individual template -
			     templates include their partials with __DIR__, so a partial has to sit
			     beside the entry point that includes it. -->
			<templates path="/templates/codegen"/>

			<!-- Append Prefixes/Suffixes to the Following Code Generated Items -->
			<className prefix="" suffix=""/>
			<associatedObjectName prefix="" suffix=""/>

			<!-- Namespaces the hand-editable subclasses are generated into, available
			     to every template as $codegen->namespaceData and $codegen->namespaceType.
			     These must agree with the templates' TargetDirectory under your PSR-4
			     map - PSR-4 resolves classes by path, so a mismatch produces files that
			     lint clean and never load.
			     Omit the tag to keep the defaults, App\Data and App\Type. -->
			<namespace data="App\Data" type="App\Type"/>

			<!-- Table Type Identifiers - Used to Classify Tables in your Data Model -->
			<typeTableIdentifier suffix="_type"/>
			<associationTableIdentifier suffix="_assn"/>

			<!-- Other -->
			<stripFromTableName prefix=""/>

			<!-- Specific Tables to Exclude or Include in the Cog\Codegen\CodeGen process -->
			<!--
					* "include" is used to override any "exclude" patterns or lists
					* "list" should be a  comma-separated list of table names
					* "pattern" is a regexp pattern
				So for example, if you only want to codegen any table prefixed with "qc_",
				you should set an excludeTables pattern to exclude all, or "[0-9a-zA-Z_]*".
				And then you should set an includeTables pattern of "^qc_[0-9a-zA-Z_]*".
			-->
			<excludeTables pattern="" list=""/>
			<includeTables pattern="" list=""/>
		</database>
	</dataSources>
</codegen>
